---
const { label, value, detail = '' } = Astro.props;
---
<div class="stat card"><span>{label}</span><strong>{value}</strong>{detail && <small>{detail}</small>}</div>
<style>
.stat{padding:1.1rem 1.15rem;min-height:112px;display:flex;flex-direction:column;justify-content:center}
.stat span{color:var(--muted);font-size:.76rem;text-transform:uppercase;letter-spacing:.09em;font-weight:800}
.stat strong{color:var(--navy);font-family:Georgia,serif;font-size:1.72rem;margin-top:.2rem}
.stat small{color:var(--muted);margin-top:.12rem}
</style>