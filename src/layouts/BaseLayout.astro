---
const { title='República Cívica de Asteria', description='Portal público y enciclopédico de la República Cívica de Asteria' }=Astro.props;
const path=Astro.url.pathname;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#0d294b"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
<title>{title}</title>
<style is:global>
:root{--navy:#0d294b;--navy2:#173a62;--gold:#c99a32;--goldsoft:#e7d5a5;--paper:#f5f1e7;--ink:#17202a;--muted:#66707a;--white:#fffdf8;--line:rgba(13,41,75,.16);--shadow:0 20px 50px rgba(16,30,45,.14);--radius:20px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--paper);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.62}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.18;background-image:radial-gradient(rgba(13,41,75,.16) .6px,transparent .6px);background-size:9px 9px;z-index:-1}
a{color:inherit}img{max-width:100%;display:block}.container{width:min(1180px,calc(100% - 40px));margin:auto}.narrow{width:min(820px,calc(100% - 40px));margin:auto}
.eyebrow{font-size:.74rem;font-weight:850;letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}
h1,h2,h3{font-family:Georgia,"Times New Roman",serif;color:var(--navy);line-height:1.08;margin:0 0 .75rem}h1{font-size:clamp(2.7rem,6vw,5.5rem);letter-spacing:-.04em}h2{font-size:clamp(2rem,4vw,3.2rem);letter-spacing:-.025em}h3{font-size:1.35rem}p{margin:0 0 1rem}
.lead{font-size:clamp(1.08rem,1.8vw,1.34rem);color:#394553;max-width:760px}.section{padding:74px 0}.section-tight{padding:42px 0}.section-dark{background:var(--navy);color:#edf3f8}.section-dark h2,.section-dark h3{color:white}.section-dark .lead{color:#ced9e6}
.card{background:rgba(255,253,248,.82);border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 10px 28px rgba(16,30,45,.06)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:.88rem 1.2rem;border-radius:999px;border:1px solid transparent;text-decoration:none;font-weight:850;transition:.18s ease;cursor:pointer}.btn-primary{background:var(--navy);color:#fff}.btn-primary:hover{background:var(--navy2);transform:translateY(-1px)}.btn-secondary{border-color:var(--line);background:rgba(255,255,255,.6);color:var(--navy)}
.page-hero{padding:82px 0 54px}.page-hero h1{font-size:clamp(2.9rem,5vw,4.6rem)}.prose p{margin-bottom:1.15rem}.prose h2{margin-top:2.4rem}.quote{padding:1.2rem 1.4rem;border-left:4px solid var(--gold);background:rgba(201,154,50,.09);border-radius:0 14px 14px 0;font-family:Georgia,serif;font-size:1.16rem;color:var(--navy)}
@media(max-width:760px){.container,.narrow{width:min(100% - 26px,1180px)}.section{padding:54px 0}}
</style>
</head>
<body>
<header class="site-header"><div class="container header-inner">
<a class="brand" href="/"><img src="/images/emblema.png" alt="Emblema de Asteria"/><span><strong>ASTERIA</strong><small>República Cívica</small></span></a>
<button class="menu-btn" aria-label="Abrir menú" data-menu>☰</button>
<nav data-nav>
<a class:list={[{active:path==='/historia/'}]} href="/historia/">Historia</a>
<a class:list={[{active:path==='/instituciones/'}]} href="/instituciones/">Instituciones</a>
<a class:list={[{active:path==='/ciudades/'}]} href="/ciudades/">Ciudades</a>
<a class:list={[{active:path==='/cultura/'}]} href="/cultura/">Cultura</a>
<a class:list={[{active:path==='/relatos/'}]} href="/relatos/">Relatos</a>
<a class:list={[{active:path==='/documentos/'}]} href="/documentos/">Documentos</a>
<a class="civis-link" href="/civis/">Civis</a>
</nav></div></header>
<main><slot/></main>
<footer><div class="container footer-grid"><div><div class="footer-brand">ASTERIA</div><p>Scientia · Libertas · Progressus</p></div><div><strong>Explorar</strong><a href="/historia/">Historia</a><a href="/instituciones/">Instituciones</a><a href="/ciudades/">Ciudades</a><a href="/documentos/">Documentos</a></div><div><strong>Proyecto</strong><p>Universo ficticio y proyecto de worldbuilding. No representa un Estado real.</p></div></div><div class="container footer-bottom">© 2026 Proyecto Asteria</div></footer>
<script is:inline>const b=document.querySelector('[data-menu]');const n=document.querySelector('[data-nav]');b?.addEventListener('click',()=>n?.classList.toggle('open'));</script>
<style is:global>
.site-header{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);background:rgba(245,241,231,.91);border-bottom:1px solid var(--line)}.header-inner{height:78px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:.65rem;text-decoration:none;color:var(--navy)}.brand img{width:40px;height:40px}.brand span{display:flex;flex-direction:column;line-height:1}.brand strong{letter-spacing:.12em;font-size:.92rem}.brand small{margin-top:.25rem;color:var(--muted);font-size:.68rem;letter-spacing:.06em}
nav{display:flex;align-items:center;gap:1rem}nav a{text-decoration:none;font-weight:760;font-size:.86rem;color:#43505d;padding:.55rem .15rem;border-bottom:2px solid transparent}nav a:hover,nav a.active{color:var(--navy);border-color:var(--gold)}nav .civis-link{padding:.62rem .95rem;background:var(--navy);color:#fff;border-radius:999px;border:0}.menu-btn{display:none;border:1px solid var(--line);background:var(--white);border-radius:10px;padding:.45rem .65rem;font-size:1.2rem}
footer{background:#081b31;color:#cbd5df;padding:54px 0 28px}.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:2rem}footer strong,.footer-brand{color:#fff}.footer-brand{font-family:Georgia,serif;font-size:1.7rem;letter-spacing:.08em}footer a{display:block;color:#cbd5df;text-decoration:none;margin-top:.5rem}.footer-bottom{margin-top:36px;padding-top:22px;border-top:1px solid rgba(255,255,255,.1);font-size:.8rem;color:#9fb0c0}
@media(max-width:920px){.menu-btn{display:block}.site-header nav{display:none;position:absolute;top:78px;left:13px;right:13px;flex-direction:column;align-items:stretch;background:var(--white);padding:1rem;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow)}.site-header nav.open{display:flex}.footer-grid{grid-template-columns:1fr}}
</style>
</body></html>