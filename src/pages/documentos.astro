.featured-section{padding-top:38px}.featured-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:3rem;align-items:center}.constitution-card{min-height:470px;background:#f7f3e8;overflow:hidden;position:relative;padding:2rem;display:flex;flex-direction:column;justify-content:space-between}.constitution-card:before{content:"";position:absolute;inset:0;border:12px solid rgba(13,41,75,.045);pointer-events:none}.doc-band{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:.8rem}.doc-band span,.doc-band strong{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:900}.doc-band span{color:var(--gold)}.doc-band strong{color:var(--navy)}.doc-symbol{display:grid;place-items:center;flex:1}.doc-symbol img{width:135px;height:135px;object-fit:contain}.doc-cover-copy small{letter-spacing:.16em;color:var(--gold);font-weight:900}.doc-cover-copy h2{font-size:3rem;margin:.35rem 0}.doc-cover-copy p{color:var(--muted);margin:0}.featured-copy>p:not(.lead){color:var(--muted)}.featured-actions{display:flex;gap:.65rem;flex-wrap:wrap;margin-top:1.25rem}
.catalog-section{background:#efeee9}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:1.4rem}.section-heading>p{max-width:470px;color:var(--muted);margin:0}.catalog{display:grid;gap:.8rem}.document-row{padding:1.15rem;display:grid;grid-template-columns:190px minmax(0,1fr) 128px;gap:1.2rem;align-items:center}.document-row[hidden]{display:none}.doc-index span,.doc-index strong{display:block}.doc-index span{font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);font-weight:900}.doc-index strong{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.76rem;color:#52606d;margin-top:.35rem}.doc-title-row{display:flex;justify-content:space-between;gap:1rem;align-items:start}.doc-title-row h3{font-size:1.45rem;margin-bottom:.35rem}.doc-title-row p{color:var(--muted);margin:0;max-width:760px;font-size:.9rem}.status{white-space:nowrap;border-radius:999px;padding:.26rem .52rem;font-size:.66rem;font-weight:850;border:1px solid var(--line);background:#edf0ec;color:#52606d}.status.normativa{background:#e6edf5;color:#244568}.status.referencia{background:#f4ecd7;color:#725b25}.status.economia{background:#e4f0e7;color:#315d3e}.status.estrategia{background:#e5edf1;color:#2f5969}.status.historia{background:#eee7df;color:#70523d}.status.ficcion{background:#ece5ef;color:#62486c}.doc-facts{display:flex;gap:1.4rem;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:.7rem;margin-top:.8rem}.doc-facts span{display:flex;gap:.35rem;align-items:baseline}.doc-facts small{color:var(--muted)}.doc-facts b{color:var(--navy);font-size:.78rem}.doc-actions{display:flex;flex-direction:column;gap:.45rem;align-items:stretch}.doc-actions .btn{padding:.65rem .8rem;font-size:.78rem}.download-link{text-align:center;font-size:.72rem;font-weight:850;color:var(--navy);text-underline-offset:3px}.empty-state{padding:1.4rem;text-align:center;margin-top:.8rem}.empty-state strong,.empty-state span{display:block}.empty-state span{color:var(--muted);font-size:.85rem;margin-top:.2rem}
.dark-heading>p{color:#cad6e1}.collection-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.collection{padding:1.25rem;border:1px solid rgba(255,255,255,.14);border-radius:16px;background:rgba(255,255,255,.045);text-decoration:none;transition:.18s}.collection:hover{transform:translateY(-3px);background:rgba(255,255,255,.075)}.collection>span{color:var(--gold);font-weight:900}.collection h3{color:white;margin:.45rem 0}.collection p{color:#cdd8e2;font-size:.88rem}.collection strong{color:white;font-size:.76rem}
