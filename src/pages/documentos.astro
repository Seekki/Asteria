.archive-id{overflow:hidden}.archive-id>div:nth-child(2){padding:1.15rem 1.2rem .8rem;text-align:center}.archive-id>div:nth-child(2) span,.archive-id>div:nth-child(2) strong,.archive-id>div:nth-child(2) small{display:block}.archive-id>div:nth-child(2) span{font-size:.64rem;letter-spacing:.15em;color:var(--gold);font-weight:900}.archive-id>div:nth-child(2) strong{font-family:Georgia,serif;color:var(--navy);font-size:1.5rem}.archive-id>div:nth-child(2) small{color:var(--muted)}.seal{height:145px;background:var(--navy);display:grid;place-items:center}.seal img{width:95px;height:95px;object-fit:contain}.archive-id dl{margin:0;padding:0 1.2rem 1rem}.archive-id dl div{display:flex;justify-content:space-between;gap:1rem;padding:.62rem 0;border-top:1px solid var(--line)}.archive-id dt{color:var(--muted);font-size:.78rem}.archive-id dd{margin:0;font-weight:850;color:var(--navy);text-align:right;font-size:.8rem}
