round:rgba(255,253,248,.72);padding:1rem;display:flex;gap:.85rem}.status-number{font-family:Georgia,serif;font-size:2rem;color:var(--navy);line-height:1}.status-card small,.status-card strong{display:block}.status-card small{font-size:.6rem;color:var(--gold);letter-spacing:.12em;font-weight:900}.status-card strong{color:var(--navy);font-size:.86rem;margin:.22rem 0}.status-card p{color:var(--muted);font-size:.75rem;margin:0}.status-card.urgent{border-color:rgba(201,154,50,.55);background:#fffaf0}.services{padding:1.15rem}.block-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:.8rem}.block-head span{display:block;font-size:.64rem;text-transform:uppercase;letter-spacing:.13em;color:var(--gold);font-weight:900}.block-head h3{margin:.2rem 0 0}.block-head small,.block-head>a{font-size:.72rem;color:var(--muted)}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);border:1px solid var(--line);border-radius:14px;overflow:hidden}.service-grid button,.service-grid a{appearance:none;border:0;border-bottom:1px solid var(--line);background:white;padding:1rem;text-align:left;text-decoration:none;display:grid;grid-template-columns:30px 1fr auto;gap:.7rem;align-items:center;color:inherit;cursor:pointer}.service-grid button:nth-child(odd),.service-grid a:nth-child(odd){border-right:1px solid var(--line)}.service-grid button:nth-last-child(-n+2),.service-grid a:nth-last-child(-n+2){border-bottom:0}.service-grid b{color:var(--gold);font-size:.68rem}.service-grid span strong,.service-grid span small{display:block}.service-grid span strong{color:var(--navy)}.service-grid span small{color:var(--muted);font-size:.72rem;margin-top:.12rem}.service-grid i{font-style:normal;color:var(--gold);font-weight:900}.service-grid button:hover,.service-grid a:hover{background:#f8f5ec}

.notifications-section{background:#efeee9}.split-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:1.2rem;align-items:start}.inbox{padding:1.15rem}.notice{display:grid;grid-template-columns:36px minmax(0,1fr) auto;gap:.85rem;padding:1rem .2rem;border-top:1px solid var(--line);align-items:start}.notice-icon{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#edf0ec;color:var(--navy);font-weight:900}.notice div:nth-child(2)>span,.notice div:nth-child(2)>strong{display:block}.notice div:nth-child(2)>span{font-size:.68rem;color:var(--muted)}.notice div:nth-child(2)>strong{color:var(--navy);margin:.14rem 0}.notice p{font-size:.8rem;color:var(--muted);margin:0}.notice>b{font-size:.65rem;color:var(--muted);background:#edf0ec;border-radius:999px;padding:.22rem .5rem}.notice.unread>b{color:#725b25;background:#f4ecd7}.process-card{padding:1.3rem}.process-type{font-size:.64rem;letter-spacing:.14em;color:var(--gold);font-weight:900}.process-card h3{margin:.35rem 0}.process-id{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);font-size:.75rem}.progress{height:5px;border-radius:999px;background:#dde2e3;margin:1.2rem 0}.progress i{display:block;width:67%;height:100%;border-radius:inherit;background:var(--gold)}.steps>div{display:flex;gap:.7rem;margin:.85rem 0;color:#8a9299}.steps b{width:25px;height:25px;border-radius:50%;border:1px solid #b8c0c5;display:grid;place-items:center;font-size:.68rem;flex:0 0 25px}.steps span strong,.steps span small{display:block}.steps span strong{font-size:.82rem}.steps span small{font-size:.7rem}.steps .done,.steps .current{color:var(--navy)}.steps .done b{background:var(--navy);color:white;border-color:var(--navy)}.steps .current b{background:var(--gold);color:white;border-color:var(--gold)}.process-card .btn{margin-top:.8rem;width:100%}

