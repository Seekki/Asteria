---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Civis — Portal ciudadano de Asteria" description="Civis es la sede digital ciudadana de la República Cívica de Asteria: trámites, expedientes, consultas, transparencia y participación pública.">

<section class="civis-hero">
  <div class="container hero-grid">
    <div>
      <div class="eyebrow">CIVIS · Portal ciudadano</div>
      <h1>Tu relación con el Estado, en un solo sitio.</h1>
      <p class="lead">Trámites, expedientes, notificaciones, consultas públicas y acceso a información del Estado. Civis está diseñado para que una persona pueda entender qué está ocurriendo sin conocer la estructura interna de la administración.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#panel">Entrar en la demostración</a>
        <a class="btn btn-secondary" href="#participacion">Ver participación pública</a>
      </div>
      <div class="privacy-note"><span>Privacidad por diseño</span><strong>La demostración funciona localmente y no almacena datos personales.</strong></div>
    </div>

    <aside class="access-card card">
      <div class="access-head">
        <img src="/images/branding/emblema.png" alt="Emblema de Asteria"/>
        <div><span>REPÚBLICA CÍVICA DE ASTERIA</span><strong>Civis</strong></div>
      </div>
      <div class="access-copy">
        <small>ACCESO CIUDADANO</small>
        <h2>Identidad cívica</h2>
        <p>En el sistema real, el acceso se realizaría mediante identidad digital nacional o credencial física vinculada.</p>
      </div>
      <div class="access-status"><i></i><span>Entorno de demostración</span></div>
    </aside>
  </div>
</section>

<section class="section-tight" id="panel">
  <div class="container dashboard-shell">
    <aside class="profile card">
      <div class="profile-head">
        <div class="avatar">IV</div>
        <div><span>Sesión de demostración</span><h2>Iria Varel</h2><small>AST-2048-7719 · Aster</small></div>
      </div>
      <div class="profile-state">
        <div><span>Identidad</span><strong>Verificada</strong></div>
        <div><span>Domicilio cívico</span><strong>Aster · Centralia</strong></div>
        <div><span>Buzón público</span><strong>Activo</strong></div>
      </div>
      <button class="profile-button" type="button" data-demo-message="La gestión de identidad está desactivada en esta maqueta.">Gestionar identidad <span>→</span></button>
      <div class="demo-message" data-demo-output aria-live="polite"></div>
    </aside>

    <div class="dashboard-main">
      <div class="dashboard-top">
        <div><div class="eyebrow">Panel ciudadano</div><h2>Buenas tardes, Iria.</h2><p>Esto es lo que requiere tu atención hoy.</p></div>
        <div class="date-chip"><span>Último acceso</span><strong>13 oct 2026 · 15:41</strong></div>
      </div>

      <div class="status-grid">
        <article class="status-card urgent">
          <span class="status-number">2</span>
          <div><small>NOTIFICACIONES</small><strong>Dos comunicaciones nuevas</strong><p>Una requiere lectura antes del 20 de octubre.</p></div>
        </article>
        <article class="status-card">
          <span class="status-number">1</span>
          <div><small>EXPEDIENTES</small><strong>Un trámite en curso</strong><p>Solicitud de bonificación energética · en revisión.</p></div>
        </article>
        <article class="status-card">
          <span class="status-number">3</span>
          <div><small>CONSULTAS</small><strong>Tres procesos abiertos</strong><p>Puedes participar hasta final de mes.</p></div>
        </article>
      </div>

      <div class="services card">
        <div class="block-head"><div><span>Servicios frecuentes</span><h3>¿Qué necesitas hacer?</h3></div><small>Accesos simulados</small></div>
        <div class="service-grid">
          <button type="button" data-demo-message="El registro de trámites está desactivado en esta maqueta."><b>01</b><span><strong>Iniciar un trámite</strong><small>Solicitudes, licencias y ayudas</small></span><i>→</i></button>
          <button type="button" data-demo-message="La consulta de expedientes está desactivada en esta maqueta."><b>02</b><span><strong>Mis expedientes</strong><small>Estado, documentos y plazos</small></span><i>→</i></button>
          <button type="button" data-demo-message="El buzón ciudadano está desactivado en esta maqueta."><b>03</b><span><strong>Notificaciones</strong><small>Comunicaciones oficiales</small></span><i>→</i></button>
          <a href="#participacion"><b>04</b><span><strong>Participación pública</strong><small>Consultas y propuestas</small></span><i>→</i></a>
          <a href="/documentos/"><b>05</b><span><strong>Archivo y Gaceta</strong><small>Normativa y publicaciones</small></span><i>→</i></a>
          <a href="/instituciones/"><b>06</b><span><strong>Instituciones</strong><small>Competencias y responsables</small></span><i>→</i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section notifications-section">
  <div class="container split-grid">
    <div class="card inbox">
      <div class="block-head"><div><span>Buzón ciudadano</span><h3>Notificaciones recientes</h3></div><a href="#panel">Ver panel</a></div>
      <article class="notice unread">
        <div class="notice-icon">!</div>
        <div><span>Dirección Nacional de Energía · 12 oct</span><strong>Documentación adicional para expediente EN-26-10491</strong><p>Se solicita una acreditación complementaria. Plazo de respuesta: 20 de octubre de 2026.</p></div>
        <b>Nueva</b>
      </article>
      <article class="notice unread">
        <div class="notice-icon">i</div>
        <div><span>Ayuntamiento de Aster · 11 oct</span><strong>Obras nocturnas en la línea T3</strong><p>Afectación prevista entre Estación Central y La Ribera durante cuatro noches.</p></div>
        <b>Nueva</b>
      </article>
      <article class="notice">
        <div class="notice-icon">✓</div>
        <div><span>Hacienda · 4 oct</span><strong>Declaración anual archivada</strong><p>El expediente fiscal 2025 se ha cerrado sin actuaciones pendientes.</p></div>
        <b>Leída</b>
      </article>
    </div>

    <aside class="card process-card">
      <span class="process-type">EXPEDIENTE ACTIVO</span>
      <h3>Bonificación de eficiencia energética</h3>
      <p class="process-id">EN-26-10491</p>
      <div class="progress"><i></i></div>
      <div class="steps">
        <div class="done"><b>1</b><span><strong>Solicitud registrada</strong><small>28 sep 2026</small></span></div>
        <div class="done"><b>2</b><span><strong>Validación documental</strong><small>Completada</small></span></div>
        <div class="current"><b>3</b><span><strong>Revisión técnica</strong><small>En curso</small></span></div>
        <div><b>4</b><span><strong>Resolución</strong><small>Pendiente</small></span></div>
      </div>
      <button class="btn btn-secondary" type="button" data-demo-message="El detalle completo del expediente no está disponible en la demostración.">Ver expediente</button>
    </aside>
  </div>
</section>

<section class="section section-dark participation-section" id="participacion">
  <div class="container">
    <div class="section-heading dark-heading">
      <div><div class="eyebrow">Participación pública</div><h2>Opinar antes de que la decisión esté tomada.</h2></div>
      <p>Civis publica consultas, documentos técnicos, alternativas y respuestas de la administración. Participar no convierte una cuestión técnica en una votación vinculante, pero obliga al Estado a escuchar y responder.</p>
    </div>

    <div class="consult-grid">
      <article class="consult">
        <div class="consult-meta"><span>Educación</span><time>Hasta 28 oct</time></div>
        <h3>Revisión del currículo común de secundaria 2027–2034</h3>
        <p>Consulta sobre prioridades formativas, carga lectiva y equilibrio entre materias comunes, optativas y formación aplicada.</p>
        <div class="consult-foot"><span>18.426 aportaciones</span><button type="button" data-demo-message="La participación está desactivada en esta maqueta.">Participar →</button></div>
      </article>
      <article class="consult">
        <div class="consult-meta"><span>Movilidad</span><time>Hasta 31 oct</time></div>
        <h3>Nuevo corredor ferroviario Aster–Lira</h3>
        <p>Comparativa pública de tres alternativas de trazado, costes, demanda prevista e impacto territorial.</p>
        <div class="consult-foot"><span>9.817 aportaciones</span><button type="button" data-demo-message="La participación está desactivada en esta maqueta.">Participar →</button></div>
      </article>
      <article class="consult">
        <div class="consult-meta"><span>Salud pública</span><time>Hasta 6 nov</time></div>
        <h3>Plan nacional de atención primaria 2027</h3>
        <p>Observaciones sobre horarios, cobertura rural, telemedicina y criterios para ampliar plantillas.</p>
        <div class="consult-foot"><span>6.204 aportaciones</span><button type="button" data-demo-message="La participación está desactivada en esta maqueta.">Participar →</button></div>
      </article>
    </div>
  </div>
</section>

<section class="section transparency-section">
  <div class="container transparency-grid">
    <div>
      <div class="eyebrow">Transparencia por defecto</div>
      <h2>La administración debe poder explicar qué decidió y por qué.</h2>
      <p class="lead">Civis no solo sirve para pedir cosas al Estado. También permite seguir presupuestos, contratos, responsables, indicadores y el recorrido de una decisión pública.</p>
      <a class="btn btn-primary" href="/documentos/">Abrir Archivo y Gaceta →</a>
    </div>
    <div class="transparency-card card">
      <div class="trans-head"><span>Panel público · ejemplo</span><strong>Dirección Nacional de Infraestructuras</strong></div>
      <div class="metric"><span>Ejecución presupuestaria 2026</span><strong>71,4 %</strong></div>
      <div class="metric"><span>Contratos publicados</span><strong>1.284</strong></div>
      <div class="metric"><span>Indicadores con datos abiertos</span><strong>94 %</strong></div>
      <div class="metric"><span>Tiempo medio de respuesta</span><strong>6,2 días</strong></div>
      <div class="trace">Última actualización pública · 13 oct 2026 · 14:00</div>
    </div>
  </div>
</section>

<section class="section identity-demo" id="identidad">
  <div class="container demo-grid">
    <form class="card form" id="citizen-form">
      <div class="eyebrow">Identidad simbólica</div>
      <h2>Genera una credencial de demostración.</h2>
      <p>Esta función conserva la pequeña demo original de Civis. No crea una cuenta real ni envía información a ningún servidor.</p>
      <label>Nombre público<input required name="name" maxlength="70" placeholder="Tu nombre"/></label>
      <label>Ciudad de afinidad<select name="city"><option>Aster</option><option>Veyra</option><option>Lira</option><option>Orsen</option><option>Cael</option></select></label>
      <label class="check"><input required type="checkbox"/><span>Acepto el compromiso cívico: respetar la libertad de los demás como deseo que sea respetada la mía y contribuir, según mis capacidades, a la sociedad.</span></label>
      <button class="btn btn-primary" type="submit">Emitir vista previa</button>
      <p class="privacy">Demo local: no hay cuenta, base de datos ni registro persistente.</p>
    </form>

    <div class="citizen-card" id="citizen-card">
      <div class="cc-top"><span>REPÚBLICA CÍVICA DE ASTERIA</span><img src="/images/branding/emblema.png" alt=""/></div>
      <div class="cc-main"><small>IDENTIDAD SIMBÓLICA · CIVIS</small><h2 id="card-name">Ciudadano/a de Asteria</h2><div class="cc-data"><div><span>ID CÍVICO</span><strong id="card-id">AST-DEMO-0000</strong></div><div><span>CIUDAD</span><strong id="card-city">Aster</strong></div><div><span>ALTA</span><strong id="card-date">—</strong></div></div></div>
      <div class="cc-bottom"><span>Scientia · Libertas · Progressus</span><b>DEMOSTRACIÓN</b></div>
    </div>
  </div>
  <div class="narrow welcome-quote">«Bienvenido a casa.» · «Benvingut a casa.»</div>
</section>

<div class="toast" data-toast role="status" aria-live="polite"></div>

<script is:inline>
  const form = document.getElementById('citizen-form');
  form?.addEventListener('submit', event => {
    event.preventDefault();
    const data = new FormData(form);
    const name = (data.get('name') || 'Ciudadano/a').toString().trim();
    const city = (data.get('city') || 'Aster').toString();
    const code = Math.floor(1000 + Math.random() * 9000);
    const now = new Intl.DateTimeFormat('es-ES',{day:'2-digit',month:'short',year:'numeric'}).format(new Date());
    document.getElementById('card-name').textContent = name;
    document.getElementById('card-city').textContent = city;
    document.getElementById('card-id').textContent = 'AST-DEMO-' + code;
    document.getElementById('card-date').textContent = now;
    document.getElementById('citizen-card').classList.add('issued');
  });

  const toast = document.querySelector('[data-toast]');
  let toastTimer;
  document.querySelectorAll('[data-demo-message]').forEach(element => {
    element.addEventListener('click', () => {
      const message = element.dataset.demoMessage || 'Función no disponible en la demostración.';
      const localOutput = element.closest('.profile')?.querySelector('[data-demo-output]');
      if(localOutput){
        localOutput.textContent = message;
        window.setTimeout(() => localOutput.textContent = '', 3500);
        return;
      }
      if(!toast) return;
      toast.textContent = message;
      toast.classList.add('show');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('show'), 3200);
    });
  });
</script>

</BaseLayout>

