---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Civis — Portal ciudadano de Asteria" description="Civis es la sede digital ciudadana de la República Cívica de Asteria: identidad, trámites, expedientes, consultas y transparencia.">

<section class="civis-hero">
  <div class="container hero-grid">
    <div>
      <div class="eyebrow">CIVIS · Portal ciudadano</div>
      <h1>Tu relación con el Estado, en un solo sitio.</h1>
      <p class="lead">Civis reúne identidad cívica, notificaciones, expedientes, participación pública y acceso a información institucional. Esta primera versión ya permite crear una cuenta real y conservar una identidad ciudadana persistente.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#acceso">Entrar en Civis</a>
        <a class="btn btn-secondary" href="#consultas">Ver consultas públicas</a>
      </div>
      <div class="privacy-note"><span>Privacidad por diseño</span><strong>Las cuentas usan Supabase Auth. La contraseña nunca se almacena en la web de Asteria.</strong></div>
    </div>

    <aside class="access-card card">
      <div class="access-head">
        <img src="/images/branding/emblema.png" alt="Emblema de Asteria"/>
        <div><span>REPÚBLICA CÍVICA DE ASTERIA</span><strong>Civis</strong></div>
      </div>
      <div class="access-copy">
        <small>IDENTIDAD DIGITAL</small>
        <h2>Una cuenta, una identidad cívica.</h2>
        <p>Al registrarte, Civis genera un identificador permanente asociado a tu cuenta. El panel recupera tus datos cada vez que vuelves.</p>
      </div>
      <div class="access-status"><i></i><span>Backend conectado · Supabase</span></div>
    </aside>
  </div>
</section>

<section class="section-tight auth-section" id="acceso">
  <div class="container">
    <div class="auth-shell card" data-auth-view="signed-out">
      <div class="auth-intro">
        <div class="eyebrow">Acceso ciudadano</div>
        <h2>Entrar o crear una identidad.</h2>
        <p>El registro crea una cuenta real para este proyecto ficticio. Solo guardamos los datos necesarios para Civis: correo de acceso, nombre público, ciudad e identificador cívico.</p>
        <div class="auth-principles">
          <div><span>01</span><strong>Correo + contraseña</strong><small>Gestionados por Supabase Auth.</small></div>
          <div><span>02</span><strong>Perfil mínimo</strong><small>Nombre público y ciudad.</small></div>
          <div><span>03</span><strong>ID permanente</strong><small>Asignado automáticamente.</small></div>
        </div>
      </div>

      <div class="auth-tabs">
        <div class="tab-buttons">
          <button class="active" type="button" data-tab-button="login">Entrar</button>
          <button type="button" data-tab-button="register">Crear cuenta</button>
        </div>

        <form class="auth-form active" data-auth-form="login">
          <label>Correo electrónico<input type="email" name="email" autocomplete="email" required placeholder="tu@correo.com"/></label>
          <label>Contraseña<input type="password" name="password" autocomplete="current-password" required minlength="6" placeholder="••••••••"/></label>
          <button class="btn btn-primary" type="submit">Entrar en Civis</button>
          <p class="form-state" data-login-state aria-live="polite"></p>
        </form>

        <form class="auth-form" data-auth-form="register">
          <label>Nombre público<input type="text" name="display_name" maxlength="70" required placeholder="Tu nombre"/></label>
          <label>Ciudad<select name="city"><option>Aster</option><option>Veyra</option><option>Lira</option><option>Orsen</option><option>Cael</option></select></label>
          <label>Correo electrónico<input type="email" name="email" autocomplete="email" required placeholder="tu@correo.com"/></label>
          <label>Contraseña<input type="password" name="password" autocomplete="new-password" required minlength="6" placeholder="Mínimo 6 caracteres"/></label>
          <label class="check"><input type="checkbox" required/><span>Acepto que esta cuenta pertenece a un proyecto ficticio de worldbuilding y no constituye ciudadanía ni documentación oficial real.</span></label>
          <button class="btn btn-primary" type="submit">Crear identidad cívica</button>
          <p class="form-state" data-register-state aria-live="polite"></p>
        </form>
      </div>
    </div>

    <div class="account-loading card" data-auth-view="loading">
      <span class="spinner"></span><strong>Comprobando identidad cívica…</strong>
    </div>
  </div>
</section>

<section class="section-tight dashboard-section" data-auth-view="signed-in" hidden>
  <div class="container dashboard-shell">
    <aside class="profile card">
      <div class="profile-head">
        <div class="avatar" data-avatar>—</div>
        <div><span>Identidad cívica verificada</span><h2 data-profile-name>Ciudadano/a</h2><small data-profile-id>AST-—</small></div>
      </div>
      <div class="profile-state">
        <div><span>Ciudad</span><strong data-profile-city>—</strong></div>
        <div><span>Cuenta</span><strong data-profile-email>—</strong></div>
        <div><span>Estado</span><strong>Activa</strong></div>
      </div>
      <button class="profile-button" type="button" data-sign-out>Cerrar sesión <span>→</span></button>
    </aside>

    <div class="dashboard-main">
      <div class="dashboard-top">
        <div><div class="eyebrow">Panel ciudadano</div><h2>Bienvenido/a, <span data-first-name>ciudadano/a</span>.</h2><p>Este panel ya utiliza tu cuenta real de Civis.</p></div>
        <div class="date-chip"><span>Sesión</span><strong data-session-time>Activa</strong></div>
      </div>

      <div class="status-grid">
        <article class="status-card">
          <span class="status-number" data-notification-count>0</span>
          <div><small>NOTIFICACIONES</small><strong>Comunicaciones</strong><p>Mensajes asociados a tu cuenta.</p></div>
        </article>
        <article class="status-card">
          <span class="status-number" data-case-count>0</span>
          <div><small>EXPEDIENTES</small><strong>Trámites abiertos</strong><p>Los expedientes aparecerán aquí.</p></div>
        </article>
        <article class="status-card">
          <span class="status-number" data-consultation-count>0</span>
          <div><small>CONSULTAS</small><strong>Procesos abiertos</strong><p>Puedes consultar los procesos públicos activos.</p></div>
        </article>
      </div>

      <div class="services card">
        <div class="block-head"><div><span>Servicios</span><h3>Accesos rápidos</h3></div><small>Primera versión</small></div>
        <div class="service-grid">
          <button type="button" data-demo-message="La creación de trámites llegará en la siguiente fase."><b>01</b><span><strong>Iniciar un trámite</strong><small>Solicitudes, licencias y ayudas</small></span><i>→</i></button>
          <button type="button" data-demo-message="El detalle de expedientes llegará en la siguiente fase."><b>02</b><span><strong>Mis expedientes</strong><small>Estado, documentos y plazos</small></span><i>→</i></button>
          <a href="#buzon"><b>03</b><span><strong>Notificaciones</strong><small>Comunicaciones oficiales</small></span><i>→</i></a>
          <a href="#consultas"><b>04</b><span><strong>Participación pública</strong><small>Consultas abiertas</small></span><i>→</i></a>
          <a href="/documentos/"><b>05</b><span><strong>Archivo y Gaceta</strong><small>Normativa y publicaciones</small></span><i>→</i></a>
          <a href="/instituciones/"><b>06</b><span><strong>Instituciones</strong><small>Competencias y responsables</small></span><i>→</i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section notifications-section" id="buzon" data-auth-view="signed-in" hidden>
  <div class="container split-grid">
    <div class="card inbox">
      <div class="block-head"><div><span>Buzón ciudadano</span><h3>Tus notificaciones</h3></div><small data-notification-label>0 mensajes</small></div>
      <div data-notification-list>
        <div class="empty-box">Todavía no tienes notificaciones.</div>
      </div>
    </div>

    <aside class="card civic-card">
      <span class="civic-type">IDENTIDAD CÍVICA</span>
      <img src="/images/branding/emblema.png" alt="" aria-hidden="true"/>
      <h3 data-card-name>Ciudadano/a de Asteria</h3>
      <div class="civic-id" data-card-id>AST-—</div>
      <dl>
        <div><dt>Ciudad</dt><dd data-card-city>—</dd></div>
        <div><dt>Alta</dt><dd data-card-date>—</dd></div>
      </dl>
      <small>Scientia · Libertas · Progressus</small>
    </aside>
  </div>
</section>

<section class="section section-dark participation-section" id="consultas">
  <div class="container">
    <div class="section-heading dark-heading">
      <div><div class="eyebrow">Participación pública</div><h2>Consultas abiertas.</h2></div>
      <p>Las consultas pueden leerse sin cuenta. Cada ciudadano autenticado puede enviar una única aportación por consulta; después queda registrada y disponible para consulta.</p>
    </div>

    <div class="consult-grid" data-consultations>
      <article class="consult loading-consult"><h3>Cargando consultas públicas…</h3></article>
    </div>

    <div class="participation-editor card" data-participation-panel hidden>
      <div class="participation-head">
        <div>
          <span>Expediente de consulta pública</span>
          <h3 data-participation-title>Consulta pública</h3>
          <small data-consultation-authority></small>
        </div>
        <button type="button" data-participation-close aria-label="Cerrar">×</button>
      </div>

      <div class="consultation-briefing">
        <div class="briefing-block">
          <span>CONTEXTO</span>
          <p data-consultation-context></p>
        </div>
        <div class="briefing-data" data-consultation-data></div>
        <div class="briefing-block">
          <span>ALTERNATIVAS EN ESTUDIO</span>
          <div class="alternative-grid" data-consultation-alternatives></div>
        </div>
        <div class="consultation-question">
          <span>PREGUNTA DE LA CONSULTA</span>
          <strong data-consultation-question></strong>
        </div>
      </div>

      <div class="submitted-response" data-participation-existing hidden>
        <div class="submitted-badge">APORTACIÓN REGISTRADA</div>
        <p data-participation-response></p>
        <small data-participation-date></small>
      </div>
      <form data-participation-form>
        <textarea name="response" maxlength="5000" required placeholder="Escribe tu aportación. Explica qué cambiarías, qué problema ves o qué alternativa propones."></textarea>
        <div class="participation-actions">
          <small><span data-response-count>0</span>/5000 caracteres · una vez enviada, la aportación queda cerrada</small>
          <button class="btn btn-primary" type="submit">Enviar aportación</button>
        </div>
        <p class="form-state" data-participation-state aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<section class="section transparency-section">
  <div class="container transparency-grid">
    <div>
      <div class="eyebrow">Transparencia por defecto</div>
      <h2>La administración debe poder explicar qué decidió y por qué.</h2>
      <p class="lead">Civis será también el punto de acceso a presupuestos, contratos, responsables, indicadores y el recorrido de una decisión pública.</p>
      <a class="btn btn-primary" href="/documentos/">Abrir Archivo y Gaceta →</a>
    </div>
    <div class="transparency-card card">
      <div class="trans-head"><span>Estado del portal</span><strong>Segunda fase funcional</strong></div>
      <div class="metric"><span>Autenticación</span><strong>Activa</strong></div>
      <div class="metric"><span>Perfiles persistentes</span><strong>Activos</strong></div>
      <div class="metric"><span>Notificaciones personales</span><strong>Activas</strong></div>
      <div class="metric"><span>Participación ciudadana</span><strong>Activa</strong></div>
      <div class="trace">Backend · Supabase · acceso protegido mediante RLS</div>
    </div>
  </div>
</section>

<div class="toast" data-toast role="status" aria-live="polite"></div>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
  const supabase = createClient(supabaseUrl, supabaseKey);

  let currentUser = null;
  let selectedConsultationId = null;
  let consultationCache = [];
  let responseMap = new Map();

  const views = {
    loading: [...document.querySelectorAll('[data-auth-view="loading"]')],
    signedOut: [...document.querySelectorAll('[data-auth-view="signed-out"]')],
    signedIn: [...document.querySelectorAll('[data-auth-view="signed-in"]')]
  };

  const showView = (name) => {
    views.loading.forEach(el => el.hidden = name !== 'loading');
    views.signedOut.forEach(el => el.hidden = name !== 'signedOut');
    views.signedIn.forEach(el => el.hidden = name !== 'signedIn');
  };

  const toast = document.querySelector('[data-toast]');
  let toastTimer;
  const notify = (message) => {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 3200);
  };

  const escapeHtml = (value) => String(value ?? '')
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;')
    .replaceAll("'",'&#039;');

  document.querySelectorAll('[data-tab-button]').forEach(button => {
    button.addEventListener('click', () => {
      const tab = button.dataset.tabButton;
      document.querySelectorAll('[data-tab-button]').forEach(b => b.classList.toggle('active', b === button));
      document.querySelectorAll('[data-auth-form]').forEach(form => form.classList.toggle('active', form.dataset.authForm === tab));
    });
  });

  document.querySelectorAll('[data-demo-message]').forEach(button => {
    button.addEventListener('click', () => notify(button.dataset.demoMessage || 'Función todavía no disponible.'));
  });

  const loginForm = document.querySelector('[data-auth-form="login"]');
  const registerForm = document.querySelector('[data-auth-form="register"]');
  const loginState = document.querySelector('[data-login-state]');
  const registerState = document.querySelector('[data-register-state]');

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    loginState.textContent = 'Entrando…';
    const data = new FormData(loginForm);
    const { error } = await supabase.auth.signInWithPassword({
      email: String(data.get('email') || '').trim(),
      password: String(data.get('password') || '')
    });

    if (error) {
      loginState.textContent = error.message;
      return;
    }

    loginState.textContent = '';
    await refreshSession();
  });

  registerForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    registerState.textContent = 'Creando identidad…';
    const data = new FormData(registerForm);
    const displayName = String(data.get('display_name') || '').trim();
    const city = String(data.get('city') || 'Aster');
    const email = String(data.get('email') || '').trim();
    const password = String(data.get('password') || '');

    const { data: authData, error } = await supabase.auth.signUp({
      email,
      password,
      options: {
        data: { display_name: displayName, city },
        emailRedirectTo: window.location.origin + '/civis/'
      }
    });

    if (error) {
      registerState.textContent = error.message;
      return;
    }

    if (!authData.session) {
      registerState.textContent = 'Cuenta creada. Revisa tu correo para confirmar la dirección antes de entrar.';
      return;
    }

    registerState.textContent = '';
    await refreshSession();
  });

  document.querySelector('[data-sign-out]')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    currentUser = null;
    responseMap = new Map();
    showView('signedOut');
    await loadConsultations();
    notify('Sesión cerrada.');
  });

  const formatDate = (date) => new Intl.DateTimeFormat('es-ES', {
    day:'2-digit', month:'short', year:'numeric'
  }).format(new Date(date));

  const initials = (name) => name.split(/\s+/).filter(Boolean).slice(0,2).map(part => part[0]?.toUpperCase()).join('') || 'A';

  const participationPanel = document.querySelector('[data-participation-panel]');
  const participationForm = document.querySelector('[data-participation-form]');
  const participationExisting = document.querySelector('[data-participation-existing]');
  const participationResponse = document.querySelector('[data-participation-response]');
  const participationDate = document.querySelector('[data-participation-date]');
  const participationTitle = document.querySelector('[data-participation-title]');
  const consultationAuthority = document.querySelector('[data-consultation-authority]');
  const consultationContext = document.querySelector('[data-consultation-context]');
  const consultationData = document.querySelector('[data-consultation-data]');
  const consultationAlternatives = document.querySelector('[data-consultation-alternatives]');
  const consultationQuestion = document.querySelector('[data-consultation-question]');
  const participationState = document.querySelector('[data-participation-state]');
  const responseCount = document.querySelector('[data-response-count]');
  const responseField = participationForm?.querySelector('textarea[name="response"]');

  responseField?.addEventListener('input', () => {
    if (responseCount) responseCount.textContent = String(responseField.value.length);
  });

  document.querySelector('[data-participation-close]')?.addEventListener('click', () => {
    if (participationPanel) participationPanel.hidden = true;
    selectedConsultationId = null;
  });

  const showExistingResponse = (record) => {
    if (participationForm) participationForm.hidden = true;
    if (participationExisting) participationExisting.hidden = false;
    if (participationResponse) participationResponse.textContent = record.response;
    if (participationDate) participationDate.textContent = 'Registrada el ' + formatDate(record.created_at) + ' · esta aportación ya no puede modificarse.';
  };

  const showNewResponseForm = () => {
    if (participationExisting) participationExisting.hidden = true;
    if (participationForm) participationForm.hidden = false;
    if (responseField) responseField.value = '';
    if (responseCount) responseCount.textContent = '0';
    if (participationState) participationState.textContent = '';
  };

  participationForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!currentUser || !selectedConsultationId || !responseField) {
      notify('Necesitas iniciar sesión para participar.');
      return;
    }

    if (responseMap.has(selectedConsultationId)) {
      notify('Ya has enviado una aportación a esta consulta.');
      showExistingResponse(responseMap.get(selectedConsultationId));
      return;
    }

    const response = responseField.value.trim();
    if (!response) return;

    participationState.textContent = 'Registrando aportación…';

    const { data, error } = await supabase
      .from('consultation_responses')
      .insert({
        consultation_id: selectedConsultationId,
        user_id: currentUser.id,
        response
      })
      .select('consultation_id,response,created_at')
      .single();

    if (error) {
      participationState.textContent = error.code === '23505'
        ? 'Ya existe una aportación tuya para esta consulta.'
        : error.message;
      return;
    }

    responseMap.set(selectedConsultationId, data);
    participationState.textContent = '';
    showExistingResponse(data);
    await renderConsultations();
    notify('Aportación registrada. Ya puedes consultarla, pero no modificarla.');
  });

  async function openConsultation(item) {
    if (!currentUser) {
      notify('Inicia sesión en Civis para enviar una aportación.');
      document.getElementById('acceso')?.scrollIntoView({behavior:'smooth'});
      return;
    }

    selectedConsultationId = item.id;
    if (participationTitle) participationTitle.textContent = item.title;
    if (consultationAuthority) {
      const published = item.published_at ? formatDate(item.published_at + 'T12:00:00') : '—';
      consultationAuthority.textContent = (item.authority || 'Administración de Asteria') + ' · Publicada ' + published;
    }
    if (consultationContext) consultationContext.textContent = item.context || item.summary || '';
    if (consultationQuestion) consultationQuestion.textContent = item.question || '¿Qué observaciones deseas trasladar a la administración?';

    if (consultationData) {
      const metrics = Array.isArray(item.key_data) ? item.key_data : [];
      consultationData.innerHTML = metrics.map(metric =>
        '<div><span>' + escapeHtml(metric.label) + '</span><strong>' + escapeHtml(metric.value) + '</strong></div>'
      ).join('');
    }

    if (consultationAlternatives) {
      const alternatives = Array.isArray(item.alternatives) ? item.alternatives : [];
      consultationAlternatives.innerHTML = alternatives.map(option =>
        '<article><span>' + escapeHtml(option.name) + '</span><p>' + escapeHtml(option.summary) + '</p><strong>' + escapeHtml(option.impact) + '</strong></article>'
      ).join('');
    }

    const existing = responseMap.get(item.id);
    if (existing) showExistingResponse(existing);
    else showNewResponseForm();

    if (participationPanel) {
      participationPanel.hidden = false;
      participationPanel.scrollIntoView({behavior:'smooth', block:'center'});
    }
  }

  async function loadOwnResponses() {
    responseMap = new Map();
    if (!currentUser) return;

    const { data, error } = await supabase
      .from('consultation_responses')
      .select('consultation_id,response,created_at')
      .eq('user_id', currentUser.id);

    if (error || !data) return;
    data.forEach(record => responseMap.set(record.consultation_id, record));
  }

  async function renderConsultations() {
    const container = document.querySelector('[data-consultations]');
    if (!container) return;

    container.innerHTML = consultationCache.map(item => {
      const closes = new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'short'}).format(new Date(item.closes_at));
      const answered = responseMap.has(item.id);
      const buttonLabel = answered ? 'Ver consulta y aportación →' : 'Ver consulta →';
      const stateLabel = answered ? '<span class="consult-state">Respondida</span>' : '<span>Consulta pública</span>';

      return '<article class="consult">' +
        '<div class="consult-meta"><span>' + escapeHtml(item.category) + '</span><time>Hasta ' + escapeHtml(closes) + '</time></div>' +
        '<h3>' + escapeHtml(item.title) + '</h3>' +
        '<p>' + escapeHtml(item.summary) + '</p>' +
        '<div class="consult-foot">' + stateLabel + '<button class="consult-action" type="button" data-consultation-id="' + escapeHtml(item.id) + '">' + buttonLabel + '</button></div>' +
      '</article>';
    }).join('');

    container.querySelectorAll('[data-consultation-id]').forEach(button => {
      const item = consultationCache.find(entry => entry.id === button.dataset.consultationId);
      if (item) button.addEventListener('click', () => openConsultation(item));
    });

    document.querySelectorAll('[data-consultation-count]').forEach(el => el.textContent = String(consultationCache.length));
  }

  async function loadConsultations() {
    const container = document.querySelector('[data-consultations]');
    if (!container) return [];

    const { data, error } = await supabase
      .from('consultations')
      .select('id,slug,category,title,summary,closes_at,status,authority,context,question,key_data,alternatives,published_at')
      .eq('status','open')
      .order('closes_at',{ascending:true});

    if (error) {
      container.innerHTML = '<article class="consult"><h3>No se han podido cargar las consultas.</h3><p>Inténtalo de nuevo más tarde.</p></article>';
      return [];
    }

    consultationCache = data || [];
    await loadOwnResponses();
    await renderConsultations();
    return consultationCache;
  }

  async function loadAccount(user) {
    const [{ data: profile, error: profileError }, { data: notifications }, { data: cases }] = await Promise.all([
      supabase.from('profiles').select('*').eq('id',user.id).single(),
      supabase.from('notifications').select('*').order('created_at',{ascending:false}),
      supabase.from('cases').select('id,status')
    ]);

    if (profileError || !profile) {
      notify('No se ha podido cargar el perfil de Civis.');
      return;
    }

    document.querySelectorAll('[data-profile-name]').forEach(el => el.textContent = profile.display_name);
    document.querySelectorAll('[data-profile-id]').forEach(el => el.textContent = profile.civic_id);
    document.querySelectorAll('[data-profile-city]').forEach(el => el.textContent = profile.city);
    document.querySelectorAll('[data-profile-email]').forEach(el => el.textContent = user.email || '—');
    document.querySelectorAll('[data-first-name]').forEach(el => el.textContent = profile.display_name.split(/\s+/)[0] || profile.display_name);
    document.querySelectorAll('[data-avatar]').forEach(el => el.textContent = initials(profile.display_name));
    document.querySelectorAll('[data-card-name]').forEach(el => el.textContent = profile.display_name);
    document.querySelectorAll('[data-card-id]').forEach(el => el.textContent = profile.civic_id);
    document.querySelectorAll('[data-card-city]').forEach(el => el.textContent = profile.city);
    document.querySelectorAll('[data-card-date]').forEach(el => el.textContent = formatDate(profile.created_at));
    document.querySelectorAll('[data-notification-count]').forEach(el => el.textContent = String(notifications?.filter(item => !item.read_at).length || 0));
    document.querySelectorAll('[data-case-count]').forEach(el => el.textContent = String(cases?.filter(item => item.status !== 'closed').length || 0));
    document.querySelectorAll('[data-session-time]').forEach(el => el.textContent = new Intl.DateTimeFormat('es-ES',{hour:'2-digit',minute:'2-digit'}).format(new Date()));

    const list = document.querySelector('[data-notification-list]');
    const label = document.querySelector('[data-notification-label]');
    if (label) label.textContent = String(notifications?.length || 0) + ' mensajes';

    if (list) {
      if (!notifications?.length) {
        list.innerHTML = '<div class="empty-box">Todavía no tienes notificaciones.</div>';
      } else {
        list.innerHTML = notifications.map(item => {
          const status = item.read_at
            ? '<b class="notice-read">Leída</b>'
            : '<button class="notice-action" type="button" data-read-notification="' + item.id + '">Marcar como leída</button>';

          return '<article class="notice ' + (item.read_at ? '' : 'unread') + '">' +
            '<div class="notice-icon">' + (item.read_at ? '✓' : '!') + '</div>' +
            '<div class="notice-content"><span class="notice-meta">' + escapeHtml(item.issuer) + ' · ' + escapeHtml(formatDate(item.created_at)) + '</span><strong class="notice-title">' + escapeHtml(item.title) + '</strong><p class="notice-body">' + escapeHtml(item.body) + '</p></div>' +
            status +
          '</article>';
        }).join('');

        list.querySelectorAll('[data-read-notification]').forEach(button => {
          button.addEventListener('click', async () => {
            const id = Number(button.dataset.readNotification);
            const { error } = await supabase
              .from('notifications')
              .update({ read_at: new Date().toISOString() })
              .eq('id', id);

            if (error) {
              notify('No se ha podido actualizar la notificación.');
              return;
            }

            await loadAccount(user);
          });
        });
      }
    }
  }

  async function refreshSession() {
    showView('loading');
    const { data: { session } } = await supabase.auth.getSession();

    if (!session?.user) {
      currentUser = null;
      responseMap = new Map();
      showView('signedOut');
      await loadConsultations();
      return;
    }

    currentUser = session.user;
    await Promise.all([loadAccount(session.user), loadConsultations()]);
    showView('signedIn');
  }

  supabase.auth.onAuthStateChange((_event, session) => {
    currentUser = session?.user || null;
  });

  await refreshSession();
</script>


