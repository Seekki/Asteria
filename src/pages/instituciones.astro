align:center}.mini-node strong,.mini-node span{display:block}.mini-node strong{font-family:Georgia,serif}.mini-node span{font-size:.67rem;color:#c8d3df;margin-top:.2rem}.oversight{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.4rem auto 0;max-width:960px;padding-top:1.4rem;border-top:1px solid var(--line)}.oversight article{padding:1rem 1.1rem;background:rgba(13,41,75,.045);border-radius:14px}.oversight h3{font-size:1.15rem;margin:.25rem 0}.oversight p{font-size:.84rem;color:var(--muted);margin:0}.map-foot{margin:1.4rem auto 0;max-width:850px;text-align:center;padding:1rem;border-radius:12px;background:#fff7df;color:#3f4850;font-size:.9rem}.map-foot strong{color:var(--navy)}.map-foot em{font-family:Georgia,serif;color:var(--navy)}

.logic-section h2{max-width:800px}.pillars{display:grid;grid-template-columns:repeat(5,1fr);gap:.8rem;margin-top:1.5rem}.pillars article{border-top:1px solid rgba(255,255,255,.18);padding-top:1rem}.pillars span{color:var(--gold);font-weight:900}.pillars h3{font-size:1.16rem;margin-top:.45rem}.pillars p{font-size:.84rem;color:#c9d5e0;margin:0}

.institution-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.institution{padding:1.35rem;display:grid;grid-template-columns:54px 1fr;gap:1rem}.number{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:var(--navy);color:white;font-weight:900;font-size:.78rem}.institution h3{font-size:1.5rem;margin:.2rem 0 .55rem}.institution p{color:#56616c}.institution ul{margin:.7rem 0 0;padding-left:1.1rem;color:#56616c;font-size:.86rem}.institution li+li{margin-top:.28rem}.institution-type{font-size:.68rem;text-transform:uppercase;letter-spacing:.13em;color:var(--gold);font-weight:900}

.decision-section{background:linear-gradient(135deg,#eee8db,#f8f4e9)}.decision-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:3rem;align-items:start}.decision-copy{position:sticky;top:110px}.timeline{padding:1rem 1.2rem}.timeline article{display:grid;grid-template-columns:46px 1fr;gap:1rem;padding:1rem .3rem;position:relative}.timeline article:not(:last-child){border-bottom:1px solid var(--line)}.timeline b{width:38px;height:38px;border-radius:50%;background:var(--gold);color:#fff;display:grid;place-items:center}.timeline strong{color:var(--navy)}.timeline p{color:var(--muted);margin:.2rem 0 0;font-size:.88rem}

.control-table{overflow:hidden;background:rgba(255,255,255,.98);color:var(--ink)}.control-table>div{display:grid;grid-template-columns:.75fr 1.25fr 1.25fr;gap:1rem;padding:.85rem 1rem;border-bottom:1px solid var(--line);align-items:start}.control-table>div:last-child{border-bottom:0}.control-table .table-head{background:#eae4d7;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900;color:var(--navy)}.control-table strong{color:var(--navy)}.control-table span{font-size:.86rem;color:#56616c}.control-table .table-head span{color:var(--navy)}

.balance-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:1rem;align-items:start}.balance-main,.risks{padding:1.5rem}.balance-main p{color:#56616c}.risks{background:#fff9eb}.risks h3{margin-top:.35rem}.risks ul{padding-left:1.15rem;margin-bottom:0;color:#56616c}.risks li+li{margin-top:.65rem}.risks strong{color:var(--navy)}.final-doctrine{text-align:center;padding-top:30px}.big-quote{font-size:clamp(1.35rem,2.5vw,1.8rem);text-align:left}.final-doctrine p{margin:1.3rem auto;max-width:760px;color:#56616c}.constitution{display:flex;justify-content:center;gap:.6rem;flex-wrap:wrap;margin-top:1.4rem}

@media(max-width:980px){
  .pillars{grid-template-columns:repeat(2,1fr)}
  .directorates{grid-template-columns:repeat(3,1fr)}
  .decision-grid,.balance-grid{grid-template-columns:1fr}
  .decision-copy{position:static}
}
@media(max-width:760px){
  .bridge-row{margin-top:1rem}.merit-box{min-width:0;width:min(100%,360px)}
