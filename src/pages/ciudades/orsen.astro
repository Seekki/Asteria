.work-section{background:#f4f1e8}.work-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:2.5rem;align-items:center}.work-grid>div:last-child p{color:var(--muted)}.image-placeholder{min-height:390px;padding:1.4rem;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(135deg,rgba(48,58,65,.10),rgba(201,154,50,.07)),repeating-linear-gradient(-45deg,transparent,transparent 12px,rgba(13,41,75,.025) 12px,rgba(13,41,75,.025) 24px);border-style:dashed}.image-placeholder span{font-size:.67rem;text-transform:uppercase;letter-spacing:.13em;color:var(--gold);font-weight:900}.image-placeholder strong{font-family:Georgia,serif;font-size:1.55rem;color:var(--navy);margin:.35rem 0}.image-placeholder p{color:var(--muted);margin:0;max-width:38ch}
.map-section{background:#ecefed}.urban-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:center}.urban-grid>div:first-child p{color:var(--muted)}.mobility-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:1rem}.mobility-tags span{padding:.35rem .65rem;border-radius:999px;background:#e2e7e5;color:#405059;font-size:.76rem;font-weight:800}.map-placeholder{min-height:430px;padding:1.4rem;position:relative;overflow:hidden;background:linear-gradient(145deg,#e4e9e7,#faf6eb)}.map-placeholder>span{font-size:.68rem;text-transform:uppercase;letter-spacing:.13em;color:var(--gold);font-weight:900}.map-placeholder>strong{display:block;font-family:Georgia,serif;font-size:1.9rem;color:var(--navy);margin:.3rem 0}.map-placeholder>p{max-width:430px;color:var(--muted);position:relative;z-index:3}.industrial-sketch{position:absolute;inset:130px 35px 28px;overflow:hidden}.river{position:absolute;left:18%;top:-20%;height:145%;width:13%;border-left:4px solid rgba(70,137,165,.32);border-right:3px solid rgba(70,137,165,.17);transform:rotate(-12deg);border-radius:50%}.rail{position:absolute;height:3px;background:rgba(45,53,59,.22);width:87%;left:7%;top:35%;transform:rotate(-5deg)}.rail.r2{top:58%;transform:rotate(8deg)}.rail.r3{width:65%;left:26%;top:74%;transform:rotate(-16deg)}.dot{position:absolute;width:12px;height:12px;background:var(--gold);border:3px solid white;border-radius:50%;box-shadow:0 0 0 2px var(--gold)}.d1{left:36%;top:30%}.d2{left:57%;top:53%}.d3{left:70%;top:72%}.d4{left:25%;top:66%}
.places-section{background:rgba(255,253,248,.42)}.places-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.places-grid article{padding:1.2rem}.places-grid span{font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--gold);font-weight:900}.places-grid h3{font-size:1.2rem;margin:.35rem 0}.places-grid p{font-size:.85rem;color:var(--muted);margin:0}
.daily-section{background:#efeee9}.daily-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:2.5rem;align-items:center}.daily-grid>div:first-child p{color:var(--muted)}.tension-section{padding-top:28px}.tension-card{padding:1.7rem 1.8rem;display:grid;grid-template-columns:1.3fr .7fr;gap:2rem;align-items:center}.tension-card p{color:var(--muted);margin-bottom:0}.tension-points{display:flex;flex-wrap:wrap;gap:.5rem;align-content:center}.tension-points span{padding:.5rem .7rem;border-radius:999px;background:#e8e9e6;border:1px solid var(--line);font-size:.78rem;font-weight:800;color:#465057}.city-end{text-align:center;padding-top:26px}.city-end .quote{text-align:left}.end-actions{display:flex;justify-content:center;gap:.7rem;flex-wrap:wrap;margin-top:1.5rem}
@media(max-width:980px){.city-facts{grid-template-columns:repeat(2,1fr)}.city-facts div{border-bottom:1px solid var(--line)}.intro-grid,.industry-grid,.work-grid,.urban-grid,.daily-grid,.tension-card{grid-template-columns:1fr}.city-quote{position:static}.district-grid{grid-template-columns:repeat(2,1fr)}.places-grid{grid-template-columns:repeat(2,1fr)}.industry-photo{min-height:390px}}
@media(max-width:720px){.hero-photo{min-height:430px}.hero-content{bottom:2rem}.city-facts{grid-template-columns:1fr}.city-facts div{border-right:0}.section-heading{align-items:flex-start;flex-direction:column}.district-grid,.places-grid{grid-template-columns:1fr}.map-placeholder{min-height:340px}.industry-photo{min-height:320px}.image-placeholder{min-height:320px}}
</style>