.intro-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:2.5rem;align-items:start}.intro-grid p:not(.lead){color:var(--muted)}.city-quote{padding:1.5rem;background:#eef2ed;position:sticky;top:105px}.city-quote span{font-size:.67rem;text-transform:uppercase;letter-spacing:.13em;color:var(--gold);font-weight:900}.city-quote blockquote{font-family:Georgia,serif;font-size:1.55rem;color:var(--navy);margin:1rem 0;line-height:1.2}.city-quote small{color:var(--muted)}
.section-heading{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:1.5rem}.section-heading>p{max-width:430px;margin:0;color:var(--muted)}.dark-heading>p{color:#c9d6e3}.districts-section{background:#102f4a}.district-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.district-grid article{padding:1.15rem;border-top:1px solid rgba(255,255,255,.18)}.district-grid span{color:var(--gold);font-weight:900}.district-grid h3{color:white;margin:.35rem 0}.district-grid p{color:#cad6e1;margin:0;font-size:.9rem}.district-grid em{color:#fff}
.wall-section{background:#ece8de}.wall-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:2.5rem;align-items:center}.wall-grid>div p{color:var(--muted)}.wall-photo{margin:0;overflow:hidden;position:relative;min-height:460px}.wall-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.wall-photo:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(5,19,30,.76) 100%)}.wall-photo figcaption{position:absolute;left:1.25rem;right:1.25rem;bottom:1.05rem;z-index:2;color:white}.wall-photo figcaption span,.wall-photo figcaption strong{display:block}.wall-photo figcaption span{font-size:.66rem;letter-spacing:.13em;text-transform:uppercase;color:#f0c768;font-weight:900}.wall-photo figcaption strong{font-family:Georgia,serif;font-size:1.25rem;line-height:1.2;margin-top:.25rem}
.urban-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:center}.urban-copy p{color:var(--muted)}.mobility-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:1rem}.mobility-tags span{padding:.35rem .65rem;border-radius:999px;background:#e7ece9;color:#40535b;font-size:.76rem;font-weight:800}.map-placeholder{min-height:430px;padding:1.4rem;position:relative;overflow:hidden;background:linear-gradient(145deg,#e6eceb,#f8f4e8)}.map-placeholder>span{font-size:.68rem;text-transform:uppercase;letter-spacing:.13em;color:var(--gold);font-weight:900}.map-placeholder>strong{display:block;font-family:Georgia,serif;font-size:1.9rem;color:var(--navy);margin:.3rem 0}.map-placeholder>p{max-width:430px;color:var(--muted);position:relative;z-index:3}.bay-sketch{position:absolute;inset:128px 34px 25px;overflow:hidden}.coast{position:absolute;left:-18%;top:-12%;width:82%;height:125%;border-radius:0 58% 54% 0;background:rgba(60,142,171,.18);border-right:4px solid rgba(31,99,127,.36);transform:rotate(-8deg)}.route{position:absolute;display:block;height:2px;background:rgba(13,41,75,.2);width:82%;left:10%;top:42%;transform:rotate(-11deg)}.route.r2{top:64%;transform:rotate(7deg)}.dot{position:absolute;width:12px;height:12px;background:var(--gold);border:3px solid white;border-radius:50%;box-shadow:0 0 0 2px var(--gold)}.d1{left:23%;top:37%}.d2{left:43%;top:55%}.d3{left:67%;top:32%}.d4{left:72%;top:68%}
.places-section{background:rgba(255,253,248,.42)}.places-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.places-grid article{padding:1.2rem}.places-grid span{font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--gold);font-weight:900}.places-grid h3{font-size:1.2rem;margin:.35rem 0}.places-grid p{font-size:.85rem;color:var(--muted);margin:0}
.daily-section{background:#f0ede4}.daily-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:2.5rem;align-items:center}.daily-grid>div:first-child p{color:var(--muted)}.image-placeholder{min-height:390px;padding:1.4rem;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(135deg,rgba(14,70,81,.10),rgba(201,154,50,.08)),repeating-linear-gradient(-45deg,transparent,transparent 12px,rgba(13,41,75,.025) 12px,rgba(13,41,75,.025) 24px);border-style:dashed}.image-placeholder span{font-size:.67rem;text-transform:uppercase;letter-spacing:.13em;color:var(--gold);font-weight:900}.image-placeholder strong{font-family:Georgia,serif;font-size:1.55rem;color:var(--navy);margin:.35rem 0}.image-placeholder p{color:var(--muted);margin:0;max-width:38ch}
.story-section{padding-top:28px}.story-card{overflow:hidden;display:grid;grid-template-columns:320px 1fr;align-items:stretch}.story-card>div{padding:2rem;align-self:center}.story-card p{color:var(--muted);max-width:650px}.story-card img{width:100%;height:100%;object-fit:cover;min-height:360px}.city-end{text-align:center;padding-top:26px}.city-end .quote{text-align:left}.end-actions{display:flex;justify-content:center;gap:.7rem;flex-wrap:wrap;margin-top:1.5rem}
@media(max-width:980px){.city-facts{grid-template-columns:repeat(2,1fr)}.city-facts div{border-bottom:1px solid var(--line)}.intro-grid,.wall-grid,.urban-grid,.daily-grid{grid-template-columns:1fr}.city-quote{position:static}.district-grid{grid-template-columns:repeat(2,1fr)}.places-grid{grid-template-columns:repeat(2,1fr)}.story-card{grid-template-columns:260px 1fr}.wall-photo{min-height:390px}}
@media(max-width:720px){.hero-photo{min-height:430px}.hero-content{bottom:2rem}.city-facts{grid-template-columns:1fr}.city-facts div{border-right:0}.section-heading{align-items:flex-start;flex-direction:column}.district-grid,.places-grid{grid-template-columns:1fr}.map-placeholder{min-height:340px}.wall-photo{min-height:320px}.story-card{grid-template-columns:1fr}.story-card img{height:330px;min-height:0}.daily-grid{grid-template-columns:1fr}}
.map-image,.city-photo{margin:0;overflow:hidden;position:relative}.map-image{aspect-ratio:4/3;background:#e8e5dc}.city-photo{aspect-ratio:4/3;background:#e8e5dc}.map-image img,.city-photo img{width:100%;height:100%;display:block;object-fit:cover}.map-image img{object-fit:contain;background:#efece3}.city-photo img{object-position:center}
</style>